{
  "name": "isoform-website",
  "private": true,
  "version": "1.0.0",
  "description": "ISOFORM studio website: React + Tailwind CSS front end, Node.js contact API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "start": "node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run build && npm run test",
    "test:unit": "node --test \"tests/unit/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7"
  }
}
